@model PagoViewModel
@{
	ViewData["Title"] = "Editar Pago";
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Generar Pago</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>


<div class="container d-flex justify-content-center align-items-start mt-5">
    <div class="card shadow-lg p-4" style="max-width: 500px; width: 100%; background-color: #FAFF00; color: black; border-radius: 12px;">
        <h2 style="color: black; font-weight: bold;">Editar Pago de Membresía</h2>
        <p>Modifique la información del pago según sea necesario y guarde los cambios.</p>
        <form asp-action="Editar" method="post">
            <input type="hidden" asp-for="Id" />

            <!-- Selección del Usuario -->
            <div class="mb-3">
                <label asp-for="UsuarioId" class="form-label fw-bold">Nombre del Cliente</label>
                <select asp-for="UsuarioId" asp-items="Model.Usuarios" class="form-select border-dark">
                    <option value="@Model.UsuarioId" selected>@Model.Miembro</option>
                </select>
                <span asp-validation-for="UsuarioId" class="text-danger"></span>
            </div>

            <!-- Selección de la Mensualidad -->
            <div class="mb-3">
                <label asp-for="MensualidadId" class="form-label fw-bold">Tipo de Mensualidad</label>
                <select id="MensualidadId" name="MensualidadId" class="form-select border-dark" onchange="actualizarMonto()">
                    <option value="@Model.MensualidadId" selected>@Model.Membresia</option>
                    @foreach (var mensualidad in Model.Mensualidades)
                    {
                        <option value="@mensualidad.Value" data-precio="@mensualidad.Precio">@mensualidad.Text</option>
                    }
                </select>
                <span asp-validation-for="MensualidadId" class="text-danger"></span>
            </div>

            <!-- Campo de Monto -->
            <div class="mb-3">
                <label asp-for="Monto" class="form-label fw-bold">Monto a Pagar</label>
                <input asp-for="Monto" id="Monto" class="form-control border-dark" readonly />
                <span asp-validation-for="Monto" class="text-danger"></span>
            </div>

            <!-- Fecha de Pago -->
            <div class="mb-3">
                <label asp-for="FechaPago" class="form-label fw-bold">Fecha de Pago</label>
                <input asp-for="FechaPago" type="date" class="form-control border-dark" />
                <span asp-validation-for="FechaPago" class="text-danger"></span>
            </div>

            <!-- Fecha de Expiración -->
            <div class="mb-3">
                <label asp-for="FechaExpiracion" class="form-label fw-bold">Fecha de Expiración</label>
                <input asp-for="FechaExpiracion" type="date" class="form-control border-dark" />
                <span asp-validation-for="FechaExpiracion" class="text-danger"></span>
            </div>

            <!-- Botones de Acción -->
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-lg text-light" style="background-color: black;">💾 Guardar Cambios</button>
                <a href="/Pagos" class="btn btn-lg text-dark border-dark bg-white">Cancelar</a>
            </div>
        </form>
    </div>
</div>


@section scripts {

    <script>
        function actualizarMonto() {
            var selectMensualidad = document.getElementById("MensualidadId");
            var montoInput = document.getElementById("Monto");
            var precioSeleccionado = selectMensualidad.options[selectMensualidad.selectedIndex].getAttribute("data-precio");

            if (precioSeleccionado) {
                montoInput.value = precioSeleccionado;
            }
        }
    </script>
    <script>
        // $(document).ready(function () {
        //     $("#MensualidadId").change(function () {
        //         let precio = $(this).find(":selected").data("precio");
        //         $("#Monto").val(precio);
        //     });
        // });
    </script>
}