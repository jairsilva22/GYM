@model Mensualidades
@{
	ViewData["Title"] = "Editar mensualidad";
}

<h2>Editar mensualidad</h2>


<form asp-action="Editar">
	<input type="hidden" accept="" asp-for="Id" />

	<div class="form-group mb-3">
		<label asp-for="Tipo" class="control-label"></label>
		<input asp-for="Tipo" class="form-control" />
		<span asp-validation-for="Tipo" class="text-danger"></span>
	</div>

	<div class="form-group mb-3">
		<label asp-for="Precio" class="control-label"></label>
		<input asp-for="Precio" class="form-control" />
		<span asp-validation-for="Precio" class="text-danger"></span>
	</div>

	<div class="form-group mb-3">
		<label asp-for="Duracion" class="control-label"></label>
		<input asp-for="Duracion" class="form-control" />
		<span asp-validation-for="Duracion" class="text-danger"></span>
	</div>

	<button type="submit" class="btn btn-primary">Guardar</button>
	<a asp-action="Index" class="btn btn-secondary">Cancelar</a>


</form>

