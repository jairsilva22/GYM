@model DashPrincipalViewModel
@{
    ViewData["Title"] = "Home Page";
}

<style>




    .table-responsive {
    border-radius: 10px;
    overflow: hidden;
    }

    .bg-gym-primary {
    background-color: #343a40;
    color: white;
    }

    .client-avatar {
    padding: 5px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    }

    .status-badge {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
    margin-right: 5px;
    }

    .status-active {
    background-color: #28a745;
    }

    .status-warning {
    background-color: #ffc107;
    }

    .status-danger {
    background-color: #dc3545;
    }
</style>

<div class="pb-5">
    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card card-dashboard text-white bg-primary">
                <div class="card-body text-center">
                    <div class="d-flex justify-content-center align-items-center flex-column">
                        <i class="bi bi-credit-card-2-front fs-1 opacity-75 mb-2"></i>
                        <h6 class="card-title fw-bold">Miembros</h6>
                        <h2 class="mb-0">@Model.Pagados</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card card-dashboard text-white bg-success">
                <div class="card-body text-center">
                    <div class="d-flex justify-content-center align-items-center flex-column">
                        <i class="bi bi-person-check fs-1 opacity-75 mb-2"></i>
                        <h6 class="card-title fw-bold">Activos</h6>
                        <h2 class="mb-0">@Model.Activos</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card card-dashboard text-white bg-danger">
                <div class="card-body text-center">
                    <div class="d-flex justify-content-center align-items-center flex-column">
                        <i class="bi bi-person-x fs-1 opacity-75 mb-2"></i>
                        <h6 class="card-title fw-bold">Vencidos</h6>
                        <h2 class="mb-0">@Model.Vencidos</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card card-dashboard text-white bg-warning">
                <div class="card-body text-center">
                    <div class="d-flex justify-content-center align-items-center flex-column">
                        <i class="bi bi-hourglass-split fs-1 opacity-75 mb-2"></i>
                        <h6 class="card-title fw-bold">Por Vencer</h6>
                        <h2 class="mb-0">@Model.porVencer</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Miembros Activos -->
    <div class="row">
        <div class="col-md-12 mb-4">
            <div class="card card-dashboard">
                <div class="card-header bg-gym-primary">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Miembros activos</h5>
                        <div>
                            <button class="btn btn-sm btn-outline-light me-1">
                                <i class="fas fa-filter"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-light">
                                <i class="fas fa-download"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Cliente</th>
                                    <th>Plan</th>
                                    <th>Estado</th>
                                    <th>Días Restantes</th>
                                    <th>Último Pago</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pagos in Model.Pagos)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="~/img/actividad-fisica.png" alt="Cliente" class="client-avatar me-2">
                                                <div>
                                                    <h6 class="mb-0">@pagos.Nombre</h6>
                                                    <small class="text-muted">ID: @pagos.UsuarioId</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@pagos.Membresia</td>
                                        <td>
                                            <span class="status-badge status-active"></span>
                                            @pagos.Status
                                        </td>
                                        <td>@pagos.diasRestantes</td>
                                        <td>@pagos.UltimoPago</td>
                                        <td>
                                            <a asp-action="DetallesUsuario" asp-route-id="@pagos.UsuarioId" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Membresías Vencidas y Por Vencer -->
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card card-dashboard">
                <div class="card-header bg-gym-primary">
                    <h5 class="mb-0">Membresías Vencidas</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var usuariosVencidos in Model.pagosVencidos)
                        {
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center">
                                        <img src="~/img/debilidad.png" alt="Cliente" class="client-avatar me-2">
                                        <div>
                                            <h6 class="mb-0">@usuariosVencidos.Miembro</h6>
                                            <small class="text-danger">Vencido (@usuariosVencidos.ultimoPago días)</small>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card card-dashboard">
                <div class="card-header bg-gym-primary">
                    <h5 class="mb-0">Membresías por Vencer</h5>
                </div>
                <div class="card-body">
                    <div class="progress-container">
                        @foreach (var usuariosPorVencer in Model.pagosPorVencer)
                        {
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <img src="~/img/debilidad.png" alt="Cliente" class="client-avatar me-2">
                                    <div>
                                        <h6 class="mb-0">@usuariosPorVencer.Miembro</h6>
                                        <small style="color:darkorange">Restante (@usuariosPorVencer.DiasRestantes días)</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    </div>

   