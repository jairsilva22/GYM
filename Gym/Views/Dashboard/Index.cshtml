@model DashboardViewModel
@{
	ViewData["Title"] = "Dashboard";
}

<h1 class="text-center" style="color: black;">Dashboard de Pagos</h1>

<!-- Filtros -->
<div class="row my-2">
    <form id="filtroDashboard">
        <div class="row my-2">
            <div class="col-md-4">
                <label class="form-label fw-bold">Seleccionar Mes</label>
                <select class="form-select border-dark" name="mes" id="mes">
                    <option value="1">Enero</option>
                    <option value="2">Febrero</option>
                    <option value="3">Marzo</option>
                    <option value="4">Abril</option>
                    <option value="5">Mayo</option>
                    <option value="6">Junio</option>
                    <option value="7">Julio</option>
                    <option value="8">Agosto</option>
                    <option value="9">Septiembre</option>
                    <option value="10">Octubre</option>
                    <option value="11">Noviembre</option>
                    <option value="12">Diciembre</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Seleccionar Año</label>
                <select class="form-select border-dark" name="anio" id="anio">
                    <option>2025</option>
                    <option>2024</option>
                    <option>2023</option>
                    <option>2022</option>
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-dark w-100">🔍 Buscar</button>
            </div>
        </div>
    </form>
</div>

<!-- Tarjetas de Resumen -->
<div class="row text-center mb-3">
    <div class="col-md-3">
        <div class="card card-custom p-3 shadow" style="border-left:10px solid #faff00">
            <h5>💰 Ingresos Totales</h5>
            <h3 id="ingresosTotales">@Model.IngresosTotales</h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card card-custom p-3 shadow" style="border-left:10px solid #faff00">
            <h5>📄 Pagos Registrados</h5>
            <h3 id="cantidadPagos"> @Model.CantidadPagos</h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card card-custom p-3 shadow" style="border-left:10px solid #faff00">
            <h5>🧑‍🤝‍🧑 Clientes Activos</h5>
            <h3 id="clientesActivos">@Model.ClientesActivos</h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card card-custom p-3 shadow" style="border-left:10px solid #faff00; max-height:108px">
            <h5>🏆 Plan Más Vendido</h5>
            <p id="mejorPlan"><strong>@Model.PlanMasVendido</strong></p>
        </div>
    </div>
</div>

<!-- Gráfico de Ingresos -->
<div class="row mt-4">
    <div class="col-md-12 col-sm-12">
        <div class="card p-3 shadow">
            <h5 class="text-center">📊 Ingresos Mensuales</h5>
            <canvas id="graficoIngresos"></canvas>
        </div>
    </div>
</div>

<!-- Tabla de Pagos -->
<div class="row mt-4 pb-5">
    <div class="col-md-12">
        <div class="card p-3 shadow">
            <h5 class="text-center">📋 Detalles de Pagos</h5>
            <table class="table table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Cliente</th>
                        <th>Fecha de Pago</th>
                        <th>Monto</th>
                        <th>Plan</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pago in Model.Pagos)
                    {
                        <tr>
                            <td>@pago.Miembro</td>
                            <td>@pago.FechaPago.ToString("dd/MM/yyyy")</td>
                            <td>$@pago.Monto</td>
                            <td>@pago.Membresia</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>




<!-- Estilos CSS para ajustar el tamaño del gráfico -->
<style>
    #graficoIngresos {
        width: 100% !important;
        height: 300px !important; /* Ajusta la altura según tus necesidades */
    }
</style>




@section scripts{


    <script>
            document.getElementById("filtroDashboard").addEventListener("submit", async function(event) {
            event.preventDefault(); // Evita que la página se recargue
            var  mes =  document.getElementById("mes").value;
            var anio = document.getElementById("anio").value;
            console.log("Mes seleccionado:", mes);
            console.log("Año seleccionado:", anio);
            var filtro = '@Url.Action("Filtrar", "Dashboard")';


			mes = parseInt(mes);
            anio = parseInt(anio);  

            try {
                let response = await fetch(filtro, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    // Error estaba aquí - el body debe ser un JSON correctamente formateado
                    body: JSON.stringify({ mes: mes, anio: anio })
                });

                if (!response.ok) {
                    throw new Error("Error en la petición");
                }

                let data = await response.json();
                console.log("data", data);
                actualizarDashboard(data);
            } catch (error) {
                console.error("Error al obtener los datos:", error);
            }
        });

        function actualizarDashboard(data) {
            document.getElementById("ingresosTotales").innerText = `$${data.ingresosTotales}`;
            document.getElementById("cantidadPagos").innerText = data.cantidadPagos;
            document.getElementById("clientesActivos").innerText = data.clientesActivos;
            document.getElementById("mejorPlan").innerText = data.planMasVendido;

            let tbody = document.querySelector("tbody");
            tbody.innerHTML = "";

            data.pagos.forEach(pago => {
                let row = `<tr>
                            <td>${pago.miembro}</td>
                            <td>${new Date(pago.fechaPago).toLocaleDateString()}</td>
                            <td>$${pago.monto}</td>
                            <td>${pago.membresia}</td>
                          </tr>`;
                tbody.innerHTML += row;
            });
        }
    </script>

    <script>
        var ctx = document.getElementById('graficoIngresos').getContext('2d');

        // Asegurando que la resolución del gráfico sea correcta
        var canvas = document.getElementById('graficoIngresos');
        var ratio = window.devicePixelRatio || 1;
        canvas.width = canvas.offsetWidth * ratio;
        canvas.height = canvas.offsetHeight * ratio;
        ctx.scale(ratio, ratio);

        var chart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'],
                datasets: [{
                    label: 'Ingresos Mensuales',
                    data: @Html.Raw(Json.Serialize(Model.IngresosMensuales.Select(i => i.Monto))),
                    backgroundColor: 'rgba(255, 99, 132, 0.2)',
                    borderColor: 'rgba(255, 99, 132, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    </script>

}
